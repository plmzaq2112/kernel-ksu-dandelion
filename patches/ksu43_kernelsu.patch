+// Direct sys_enter replacement for kernels without CONFIG_FTRACE_SYSCALLS.
+// Patched straight into the real syscall table slot: reads the syscall number
+// back from the pt_regs (arm64 el0 entry always sets regs->syscallno == scno),
+// then routes through the same registration table as the dispatcher.
+static long __nocfi ksu_direct_syscall_entry(const struct pt_regs *regs)
+{
+    int nr = (int)regs->syscallno;
+
+    if (unlikely(nr < 0 || nr >= __NR_syscalls))
+        return -ENOSYS;
+
+    ksu_syscall_hook_fn fn = READ_ONCE(syscall_hooks[nr]);
+    if (likely(fn))
+        return fn(nr, regs);
+
+    return -ENOSYS;
+}
