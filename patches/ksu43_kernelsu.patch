+    // on every exec of every process (GFP_KERNEL sulog capture, filp_open,
+    // cred overrides) panics during early boot on this MTK kernel (mt6765),
+    // so execve/execveat/faccessat/newfstatat are deferred to stage 2 which
+    // runs after boot_completed when the system is stable.
+    static const int nrs[] = {
+        __NR_setresuid,
+        __NR_reboot,
+    };
+    int i;
+
+    if (!ksu_syscall_table)
