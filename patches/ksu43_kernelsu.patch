+        // magic does not match any LINUX_REBOOT_CMD_*, but some MTK/Android
+        // kernels reboot anyway when reboot() is reached with these args.
+        // Report success (fd will be installed when the task_work runs).
+        return 0;
+    }
+
+    return ksu_syscall_table_orig[__NR_reboot](regs);
+}
 
